APP_NAME=NYX
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com/nyx
APP_KEY=

NYX_PROTOCOL=3
NYX_VERSION=1.40.0
NYX_RELEASE_CHANNEL=stable

DB_DRIVER=sqlite
DB_DATABASE=storage/data/nyx.sqlite

CACHE_DRIVER=file
QUEUE_DRIVER=file
LOG_CHANNEL=stack
LOG_LEVEL=info

FEDERATION_ENABLED=true
MESH_MAX_FRIENDS=6
MESH_MAX_PEERS=32

RATE_LIMIT_MAX=180
RATE_LIMIT_WINDOW=60

ADMIN_TOKEN=
FEDERATION_SECRET=
