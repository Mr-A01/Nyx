{
  "name": "nyx/messenger-pro",
  "description": "NYX Messenger Pro — Federated E2EE messenger relay with hexagonal modular architecture",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "ext-sqlite3": "*",
    "ext-curl": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Nyx\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nyx\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse app --level=6",
    "serve": "php -S 0.0.0.0:8080 -t public"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable"
}
