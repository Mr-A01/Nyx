services:
  php:
    build:
      context: .
      dockerfile: docker/php/Dockerfile
    volumes:
      - ./:/var/www/nyx
      - nyx-data:/var/www/nyx/storage/data
    restart: unless-stopped
    environment:
      NYX_ENV: production
  nginx:
    image: nginx:1.27-alpine
    ports:
      - "${NYX_PORT:-8080}:80"
    volumes:
      - ./:/var/www/nyx:ro
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on: [php]
    restart: unless-stopped
volumes:
  nyx-data:
